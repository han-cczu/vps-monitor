# 拷成 .env 再填。这个文件里有密钥，chmod 600。

# 面板域名，要先把 A 记录解析到这台机器，Caddy 才签得下证书
PANEL_DOMAIN=panel.example.com

# 镜像地址。发布流水线推到 GHCR，OWNER 换成你的 GitHub 用户名 / 组织名
SERVER_IMAGE=ghcr.io/OWNER/vps-monitor-server:latest

# JWT 签名密钥，至少 32 字节。生成：openssl rand -hex 32
# 换掉它等于让所有已登录会话立即失效。
VM_JWT_SECRET=

# 业务时区：账期滚动、月度流量重置都按这个时区算日历
VM_TZ=Asia/Shanghai

# debug / info / warn / error
VM_LOG_LEVEL=info

# 「检查更新」查询的公开 GitHub 仓库（owner/repo）。只读公开发布信息，
# 不下载也不安装任何东西；留空用项目默认仓库。
VM_UPDATE_REPOSITORY=han-cczu/vps-monitor
